# Configuration template only. Copy/edit/install only after host authorization.
# No credentials belong here. The service always binds to 127.0.0.1:8765.
MARKITDOWN_DATA_DIR=/var/lib/markitdown
MARKITDOWN_DEPLOYMENT_MODE=production
MARKITDOWN_PUBLIC_ORIGIN=https://markitdown.example.com
MARKITDOWN_COOKIE_SECURE=1
MARKITDOWN_SANDBOX_RUNTIME_ROOT=/opt/markitdown/runtime-root
ORT_DISABLE_TELEMETRY=1
# Optional Docling. Provision pinned packages/models separately before enabling.
MARKITDOWN_DOCLING_ENABLED=0
# MARKITDOWN_DOCLING_PYTHON=/opt/markitdown/docling/bin/python
# MARKITDOWN_DOCLING_MODELS=/opt/markitdown/models
